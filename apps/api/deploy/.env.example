# Caddy site address (pakai subdomain .sslip.io biar dapat SSL otomatis)
# Format: <IP-PUBLIK>.sslip.io  (mis. 103.45.67.89.sslip.io)
SITE_ADDRESS=CHANGE_ME.sslip.io

# ---- APP ----
# Port internal app dipatok 3000 oleh docker-compose (APP_PORT di sini diabaikan).
APP_ENV=production
APP_NAME=POS API
APP_URL=https://CHANGE_ME.sslip.io

# ---- CORS (domain frontend Vercel, koma-pisah) ----
CORS_ORIGINS=https://CHANGE_ME.vercel.app

# ---- POSTGRES (self-hosted, docker internal network pos-net) ----
# Host = container name "pos-db" (resolvable lewat network pos-net)
POSTGRES_USER=pos
POSTGRES_PASSWORD=CHANGE_ME_ALFANUMERIK
POSTGRES_DB=pos
DATABASE_URL=postgresql://pos:CHANGE_ME_ALFANUMERIK@pos-db:5432/pos

# ---- REDIS (Redis Cloud) ----
REDIS_URL=redis://default:CHANGE_ME@redis-CHANGE_ME.redislabs.com:PORT

# ---- AUTH ----
AUTH_MODE=stateful
AUTH_TOKEN_TIMEOUT=7h
AUTH_REFRESH_TOKEN_TIMEOUT=604800000
HASH_SECRET=CHANGE_ME

# ---- STORAGE (Cloudflare R2) ----
FILESYSTEM=s3
STORAGE_SECRET=CHANGE_ME
S3_REGION=auto
S3_ACCESS=CHANGE_ME
S3_SECRET=CHANGE_ME
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_BUCKET=CHANGE_ME

# ---- MIDTRANS ----
MIDTRANS_SERVER_KEY=CHANGE_ME
MIDTRANS_CLIENT_KEY=CHANGE_ME
MIDTRANS_IS_PRODUCTION=false

# ---- OPTIONAL ----
# SENTRY_DSN=
# SMTP_USER=
# SMTP_PASS=

{
  "info": {
    "name": "POS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Point of Sale API — Product Categories, Products, Orders, Payments, Dashboard"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "POS Dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pos/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["pos", "dashboard"]
            }
          }
        }
      ]
    },
    {
      "name": "Product Categories",
      "item": [
        {
          "name": "List (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/product-categories?page=1&limit=10&orderBy[]=name:asc&orderBy[]=createdAt:desc",
              "host": ["{{baseUrl}}"],
              "path": ["product-categories"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "orderBy[]", "value": "name:asc" },
                { "key": "orderBy[]", "value": "createdAt:desc" },
                { "key": "q", "value": "", "disabled": true },
                { "key": "with[]", "value": "products", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List (POST get)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/product-categories/get",
              "host": ["{{baseUrl}}"],
              "path": ["product-categories", "get"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"limit\": 10,\n  \"orderBy\": [\"name:asc\"],\n  \"q\": \"\",\n  \"with\": [\"products\"]\n}"
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/product-categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["product-categories", "1"]
            }
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/product-categories",
              "host": ["{{baseUrl}}"],
              "path": ["product-categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Minuman\",\n  \"description\": \"Kategori untuk semua jenis minuman\"\n}"
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/product-categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["product-categories", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Minuman Segar\",\n  \"description\": \"Kategori minuman updated\"\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/product-categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["product-categories", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&orderBy[]=name:asc&orderBy[]=createdAt:desc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "orderBy[]", "value": "name:asc" },
                { "key": "orderBy[]", "value": "createdAt:desc" },
                { "key": "q", "value": "", "disabled": true },
                { "key": "isActive", "value": "true", "disabled": true },
                { "key": "categoryId", "value": "1", "disabled": true },
                { "key": "barcode", "value": "8991234560010", "disabled": true },
                { "key": "sku", "value": "KS-001", "disabled": true },
                { "key": "with[]", "value": "categories", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List (POST get)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/products/get",
              "host": ["{{baseUrl}}"],
              "path": ["products", "get"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"limit\": 10,\n  \"orderBy\": [\"name:asc\", \"createdAt:desc\"],\n  \"q\": \"\",\n  \"isActive\": true,\n  \"categoryId\": 1,\n  \"barcode\": \"8991234560010\",\n  \"sku\": \"KS-001\",\n  \"with\": [\"categories\"]\n}"
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/1?with[]=categories",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"],
              "query": [
                { "key": "with[]", "value": "categories" }
              ]
            }
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kopi Susu\",\n  \"price\": 15000,\n  \"cost\": 8000,\n  \"sku\": \"KS-001\",\n  \"barcode\": \"8991234560010\",\n  \"stock\": 50,\n  \"isActive\": true,\n  \"categoryIds\": [1, 2]\n}"
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kopi Susu Gula Aren\",\n  \"price\": 18000,\n  \"cost\": 9000,\n  \"stock\": 100,\n  \"categoryIds\": [1]\n}"
            }
          }
        },
        {
          "name": "Soft Delete",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        },
        {
          "name": "Delete Permanently",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/products/1/permanently",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1", "permanently"]
            }
          }
        },
        {
          "name": "Restore",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/products/1/restore",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1", "restore"]
            }
          }
        },
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/products/upload",
              "host": ["{{baseUrl}}"],
              "path": ["products", "upload"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "",
                  "description": "Select image file (jpg/png)"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&limit=10&orderBy[]=createdAt:desc&orderBy[]=totalAmount:asc",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "orderBy[]", "value": "createdAt:desc" },
                { "key": "orderBy[]", "value": "totalAmount:asc" },
                { "key": "status", "value": "completed", "disabled": true },
                { "key": "paymentMethod", "value": "cash", "disabled": true },
                { "key": "customerId", "value": "1", "disabled": true },
                { "key": "userId", "value": "1", "disabled": true },
                { "key": "createdAtDay", "value": "2024-01-01", "disabled": true },
                { "key": "with[]", "value": "customer", "disabled": true },
                { "key": "with[]", "value": "orderItems", "disabled": true },
                { "key": "with[]", "value": "payments", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List (POST get)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/get",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "get"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"limit\": 10,\n  \"orderBy\": [\"createdAt:desc\", \"totalAmount:asc\"],\n  \"status\": \"completed\",\n  \"paymentMethod\": \"cash\",\n  \"with\": [\"customer\", \"orderItems\", \"payments\"]\n}"
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/1?with[]=orderItems&with[]=payments&with[]=customer&with[]=user",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "1"],
              "query": [
                { "key": "with[]", "value": "orderItems" },
                { "key": "with[]", "value": "payments" },
                { "key": "with[]", "value": "customer" },
                { "key": "with[]", "value": "user" }
              ]
            }
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"userId\": 1,\n  \"paymentMethod\": \"cash\",\n  \"notes\": \"Pesanan makan di tempat\",\n  \"paymentReference\": \"PAY-001\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/orders/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "1", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/orders/1/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "1", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "List (GET)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments?page=1&limit=10&orderBy[]=createdAt:desc&orderBy[]=amount:asc&orderId=1",
              "host": ["{{baseUrl}}"],
              "path": ["payments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "orderBy[]", "value": "createdAt:desc" },
                { "key": "orderBy[]", "value": "amount:asc" },
                { "key": "orderId", "value": "1", "disabled": true },
                { "key": "status", "value": "completed", "disabled": true },
                { "key": "method", "value": "cash", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List (POST get)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/payments/get",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "get"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"limit\": 10,\n  \"orderBy\": [\"createdAt:desc\", \"amount:asc\"],\n  \"orderId\": 1,\n  \"status\": \"completed\",\n  \"method\": \"cash\"\n}"
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/1",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "1"]
            }
          }
        },
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 1,\n  \"amount\": 27500,\n  \"method\": \"card\",\n  \"reference\": \"CARD-001\"\n}"
            }
          }
        }
      ]
    }
  ]
}
